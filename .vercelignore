# Vercel build ignore configuration
# Tells Vercel to completely skip these files/folders during build
# CRITICAL: This prevents TypeScript from trying to compile server code

# Backend code - should NEVER be compiled on Vercel
server/
db/
scripts/
test/

# Config files for backend only
tsconfig.server.json
drizzle.config.ts
jest.config.js

# Environment files
.env
.env.local
.env.*.local

# Git files
.git
.gitignore

# Build outputs (already handled by Vercel)
build/
dist/
.next/

# Development files
.DS_Store
*.log
.trae
.figma
