{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/public",
  "installCommand": "npm install",
  "framework": null,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist/public"
      }
    }
  ],
  "rewrites": [
    {
      "source": "^/$",
      "destination": "/index.html"
    },
    {
      "source": "^/(about|privacy|terms|packages|blog|support|contact|search|categories|signup|login|claim-account|detective-signup|application-under-review)/?$",
      "destination": "/index.html"
    },
    {
      "source": "^/category/[^/]+/?$",
      "destination": "/index.html"
    },
    {
      "source": "^/service/[^/]+/[^/]+/[^/]+/[^/]+/[^/]+/?$",
      "destination": "/index.html"
    },
    {
      "source": "^/claim-profile/[^/]+/?$",
      "destination": "/index.html"
    },
    {
      "source": "^/(admin|detective|user)(?:/.*)?$",
      "destination": "/index.html"
    },
    {
      "source": "^/detectives/[^/]+/?$",
      "destination": "/index.html"
    },
    {
      "source": "^/detectives/[^/]+/[^/]+/?$",
      "destination": "/index.html"
    },
    {
      "source": "^/detectives/[^/]+/[^/]+/[^/]+/?$",
      "destination": "/index.html"
    },
    {
      "source": "^/detectives/[^/]+/[^/]+/[^/]+/[^/]+/?$",
      "destination": "/index.html"
    },
    {
      "source": "^/news/[^/]+/?$",
      "destination": "/index.html"
    },
    {
      "source": "^/p/[^/]+/?$",
      "destination": "/index.html"
    },
    {
      "source": "^/pages/[^/]+/?$",
      "destination": "/index.html"
    },
    {
      "source": "^/pages/[^/]+/[^/]+/?$",
      "destination": "/index.html"
    },
    {
      "source": "^/pages/[^/]+/[^/]+/[^/]+/?$",
      "destination": "/index.html"
    },
    {
      "source": "^/[^/]+/[^/]+/?$",
      "destination": "/index.html"
    },
    {
      "source": "^/[^/]+/[^/]+/[^/]+/?$",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
