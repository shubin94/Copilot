{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/public",
  "installCommand": "npm install",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://copilot-06s5.onrender.com/api/:path*"
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://copilot-06s5.onrender.com/sitemap.xml"
    },
    {
      "source": "/rss.xml",
      "destination": "https://copilot-06s5.onrender.com/rss.xml"
    },
    {
      "source": "/llms.txt",
      "destination": "https://copilot-06s5.onrender.com/llms.txt"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
