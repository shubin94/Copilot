{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/public",
  "installCommand": "npm install",
  "framework": null,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist/public"
      }
    }
  ],
  "routes": [
    {
      "src": "^/sitemap\\.xml$",
      "dest": "https://copilot-06s5.onrender.com/sitemap.xml"
    },
    {
      "src": "^/rss\\.xml$",
      "dest": "https://copilot-06s5.onrender.com/rss.xml"
    },
    {
      "src": "^/llms\\.txt$",
      "dest": "https://copilot-06s5.onrender.com/llms.txt"
    },
    {
      "src": "^/api/(.*)$",
      "dest": "https://copilot-06s5.onrender.com/api/$1"
    },
    {
      "src": "^/$",
      "dest": "/index.html"
    },
    {
      "src": "^/(about|privacy|terms|packages|blog|support|contact|search|categories|signup|login|claim-account|detective-signup|application-under-review)/?$",
      "dest": "/index.html"
    },
    {
      "src": "^/category/[^/]+/?$",
      "dest": "/index.html"
    },
    {
      "src": "^/service/[^/]+/[^/]+/[^/]+/[^/]+/[^/]+/?$",
      "dest": "/index.html"
    },
    {
      "src": "^/claim-profile/[^/]+/?$",
      "dest": "/index.html"
    },
    {
      "src": "^/(admin|detective|user)(?:/.*)?$",
      "dest": "/index.html"
    },
    {
      "src": "^/detectives/[^/]+/?$",
      "dest": "/index.html"
    },
    {
      "src": "^/detectives/[^/]+/[^/]+/?$",
      "dest": "/index.html"
    },
    {
      "src": "^/detectives/[^/]+/[^/]+/[^/]+/?$",
      "dest": "/index.html"
    },
    {
      "src": "^/detectives/[^/]+/[^/]+/[^/]+/[^/]+/?$",
      "dest": "/index.html"
    },
    {
      "src": "^/news/[^/]+/?$",
      "dest": "/index.html"
    },
    {
      "src": "^/p/[^/]+/?$",
      "dest": "/index.html"
    },
    {
      "src": "^/pages/[^/]+/?$",
      "dest": "/index.html"
    },
    {
      "src": "^/pages/[^/]+/[^/]+/?$",
      "dest": "/index.html"
    },
    {
      "src": "^/pages/[^/]+/[^/]+/[^/]+/?$",
      "dest": "/index.html"
    },
    {
      "src": "^/[^/]+/[^/]+/?$",
      "dest": "/index.html"
    },
    {
      "src": "^/[^/]+/[^/]+/[^/]+/?$",
      "dest": "/index.html"
    },
    {
      "src": "^(.*)$",
      "status": 404,
      "dest": "/404.html"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Credentials",
          "value": "true"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "https://www.askdetectives.com"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET,OPTIONS,PATCH,DELETE,POST,PUT"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "X-CSRF-Token, X-Requested-With, Accept, Accept-Version, Content-Length, Content-MD5, Content-Type, Date, X-Api-Version, Authorization, Cookie"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
